# Preferred: GitHub App authentication.
# Keep the private key in a separate PEM file and point this path at it.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/to/github-app.private-key.pem

# Alternative: personal access token, if your environment permits it.
GITHUB_ACCESS_TOKEN=

# Comma-separated repositories to monitor, for example:
# GHA_REPOS=ROCm/ATOM,owner/other-repo
GHA_REPOS=ROCm/ATOM

# Optional: set this if sbatch/sacct are not already in PATH.
# For Spur this should be the directory containing the Slurm-compatible symlinks.
SLURM_BIN_DIR=

# Default runner allocation script for a minimal Spur/Slurm setup.
ALLOCATE_RUNNER_SCRIPT_PATH=allocation_scripts/spur_basic.sh

# Cluster profile for cluster-specific sbatch defaults. Built-in profiles:
#   spur-v2: --partition=default
#   spur:    --partition=amd-spur --qos=amd-burst-qos
# Set SLURM_CLUSTER_PROFILES_FILE to point at a custom JSON profile file.
SLURM_CLUSTER_PROFILE=spur-v2
SLURM_CLUSTER_PROFILES_FILE=

# Polling and command timeouts.
NETWORK_TIMEOUT=30
SLURM_COMMAND_TIMEOUT=60
THREAD_SLEEP_TIMEOUT=10

# Resource labels in GitHub Actions jobs must include one label with this prefix.
RESOURCE_LABEL_PREFIX=slurm-runner

# Additional sbatch options appended after the selected cluster profile.
# Use this for account, QoS, constraints, reservations, or temporary overrides.
# Avoid duplicating --partition here when SLURM_CLUSTER_PROFILE already sets it.
SBATCH_EXTRA_ARGS=

# Keep logs relative to this checkout by default.
SLURM_LOG_DIR=logs

# Leave false for Spur unless your cluster has a tmpdisk GRES named tmpdisk.
INCLUDE_TMPDISK_GRES=false

# Runner package settings used by allocation_scripts/spur_basic.sh.
ACTIONS_RUNNER_PLATFORM=linux-x64
ACTIONS_RUNNER_VERSION=latest
GHA_RUNNER_WORK_ROOT=/tmp/gha-runners
